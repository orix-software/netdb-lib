[package]
name = "socketlib"
version = "2025.4"
authors = [ "Jede",]
license = "MIT OR Apache-2.0"
edition = "2018"
cpu = "6502"
readme = ""
repository = "https://github.com/orix-software/socketlib"
documentation = "https://orix-software.github.io/socketlib/api/"
description = "Socket management"
homepage = ""
buildfolder = "build"
packagetype = "tgz"
codetype = "lib"
oricutron_replace_autoboot_run = "True"
templatecode = ""
orix_minimal_kernel_version = "2025.2"
enable_publish = "True"
enable_build = "True"

[dependencies]
inetlib = "2024.4"
ch395lib = "2024.4"

[srcfolders]
